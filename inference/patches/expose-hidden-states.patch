+// ATLAS PC-202: per-layer residual stream capture for hidden-states extension.
+// Filled by decode() before each llama_process (from the union of hidden_states_layers
+// across active embedding slots), populated by atlas_capture_cb_eval during the decode,
+// then consumed by send_embedding, which takes its slot's tokens out of the captured
+// chunks. Reset before every decode.
+//
+// Embedding slots only batch with other embedding slots, so every token of such a
+// batch is an output, and llama.cpp then splits it one sequence per ubatch
+// (split_seq), in the order each sequence first appears in the batch. The callback
+// fires once per ubatch, so each layer gets one chunk per sequence, in that order.
+struct atlas_hidden_states_capture {
+    std::set<int>                                  layers_wanted;  // union across active slots
+    std::map<int, std::vector<std::vector<float>>> captured;       // layer -> per-ubatch flat [hidden_dim * n_tokens]
+    int32_t                                        hidden_dim = 0;
+    int32_t                                        batch_n_tokens = 0;
+
+    void clear() {
+        layers_wanted.clear();
+        captured.clear();
+        hidden_dim = 0;
+        batch_n_tokens = 0;
+    }
+};
+
+// cb_eval callback installed at server init. Called for each ggml node during decode.
+// Two-phase: ask=true asks whether the caller wants to observe this node,
+// ask=false delivers it. Every "yes" to ask makes the scheduler stop, compute
+// up to that node and synchronize the device, so answer yes only for the
+// requested l_out-{N} nodes: a yes for every node serializes the whole graph
+// (one GPU sync per op) and costs most of the decode speed. ask=false always
+// returns true; false would abort graph compute.
+static bool atlas_capture_cb_eval(struct ggml_tensor * t, bool ask, void * user_data) {
+    auto * cap = static_cast<atlas_hidden_states_capture *>(user_data);
+    if (cap == nullptr || cap->layers_wanted.empty()) {
+        return !ask;  // not capturing this batch
+    }
+    // Match "l_out-{N}" (post-block residual; verified against Qwen3.5-9B GGUF
+    // — both attention and DeltaNet blocks produce this name).
+    if (std::strncmp(t->name, "l_out-", 6) != 0) {
+        return !ask;
+    }
+    const int layer_idx = std::atoi(t->name + 6);
+    if (cap->layers_wanted.find(layer_idx) == cap->layers_wanted.end()) {
+        return !ask;
+    }
+    if (ask) {
+        return true;  // yes, materialize this tensor's data
+    }
+    // ask=false: data is materialized — copy it out (tensor may be on GPU,
+    // ggml_backend_tensor_get handles the device->host copy).
+    if (t->type != GGML_TYPE_F32) {
+        return true;  // unexpected dtype; skip rather than corrupt the buffer
+    }
+    const size_t n = ggml_nelements(t);
+    auto & chunks = cap->captured[layer_idx];
+    chunks.emplace_back(n);
+    ggml_backend_tensor_get(t, chunks.back().data(), 0, n * sizeof(float));
+    return true;
+}
